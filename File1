## 6. Görsel Kontrolleri — `src/components/thumbnail/ImageControls.jsx`

```jsx
import React, { useState } from 'react';
import { Sparkles, Upload } from 'lucide-react';
import { base44 } from '@/api/base44Client';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';

export default function ImageControls({ onImage }) {
  const [prompt, setPrompt] = useState('');
  const [loading, setLoading] = useState(false);
  const upload = (event) => { const file = event.target.files?.[0]; if (file) onImage(URL.createObjectURL(file)); };
  const generate = async () => {
    if (prompt.trim().length < 3) return;
    setLoading(true);
    const response = await base44.functions.invoke('generateThumbnailImage', { prompt });
    onImage(response.data.url);
    setLoading(false);
  };
  return (
    <section className="space-y-3">
      <div><p className="text-xs font-bold uppercase tracking-widest text-primary">03 · Görsel</p><h2 className="mt-1 font-heading text-lg font-bold">Kareyi güçlendir</h2></div>
      <label className="flex h-11 cursor-pointer items-center justify-center gap-2 rounded-md border border-dashed border-input text-sm font-semibold transition-colors hover:bg-accent"><Upload className="h-4 w-4" /> Kendi görselini yükle<input type="file" accept="image/*" className="hidden" onChange={upload} /></label>
      <div className="flex gap-2"><Input value={prompt} onChange={(event) => setPrompt(event.target.value)} maxLength={200} placeholder="Örn: uzayda neon araba" /><Button type="button" onClick={generate} disabled={loading || prompt.trim().length < 3} aria-label="Yapay zekâ ile görsel üret"><Sparkles className={`h-4 w-4 ${loading ? 'animate-pulse' : ''}`} /></Button></div>
      <Button type="button" variant="ghost" className="w-full text-muted-foreground" onClick={() => onImage('')}>Görselsiz devam et</Button>
    </section>
  );
}

## 1. Backend Fonksiyonu — `base44/functions/generateThumbnailImage/entry.ts`

```ts
import { createClientFromRequest } from 'npm:@base44/sdk@0.8.40';

export default async function(req: Request): Promise<Response> {
  try {
    const base44 = createClientFromRequest(req);
    const user = await base44.auth.me();
    if (!user) return Response.json({ error: 'Yetkisiz erişim' }, { status: 401 });

    const { prompt } = await req.json();
    if (typeof prompt !== 'string' || prompt.trim().length < 3 || prompt.length > 200) {
      return Response.json({ error: 'İstek 3-200 karakter olmalı' }, { status: 400 });
    }

    const result = await base44.asServiceRole.integrations.Core.GenerateImage({
      prompt: `Create a cinematic 16:9 YouTube thumbnail background, no words, no letters, no logos, strong focal point, dramatic lighting, high contrast, professional composition. Subject: ${prompt.trim()}`
    });
    return Response.json({ url: result.url });
  } catch (error) {
    return Response.json({ error: error.message }, { status: 500 });
  }
}
```


## 2. Canvas Çizim Mantığı — `src/lib/thumbnailCanvas.js`

```js
const palettes = {
  spotlight: ['#09090b', '#dc2626', '#facc15'],
  midnight: ['#020617', '#1e3a8a', '#38bdf8'],
  fresh: ['#f8fafc', '#dbeafe', '#2563eb'],
  blank: ['#18181b', '#18181b', '#ffffff'],
};

const coverImage = (ctx, image, width, height) => {
  const scale = Math.max(width / image.width, height / image.height);
  const x = (width - image.width * scale) / 2;
  const y = (height - image.height * scale) / 2;
  ctx.drawImage(image, x, y, image.width * scale, image.height * scale);
};

export const drawThumbnail = (canvas, settings, image) => {
  const ctx = canvas.getContext('2d');
  const [start, end, accent] = palettes[settings.template];
  const gradient = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
  gradient.addColorStop(0, start);
  gradient.addColorStop(1, end);
  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  if (image) {
    coverImage(ctx, image, canvas.width, canvas.height);
    const shade = ctx.createLinearGradient(0, 0, canvas.width, 0);
    shade.addColorStop(0, 'rgba(0,0,0,.84)');
    shade.addColorStop(0.62, 'rgba(0,0,0,.18)');
    shade.addColorStop(1, 'rgba(0,0,0,.05)');
    ctx.fillStyle = shade;
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  }
  ctx.fillStyle = accent;
  ctx.fillRect(72, 86, 145, 12);
  ctx.fillStyle = settings.template === 'fresh' && !image ? '#0f172a' : '#ffffff';
  ctx.font = '900 82px Arial, sans-serif';
  ctx.textBaseline = 'top';
  const words = (settings.title || 'VİDEO BAŞLIĞI').toLocaleUpperCase('tr-TR').split(' ');
  let line = '', y = 130;
  words.forEach((word) => {
    const test = `${line}${word} `;
    if (ctx.measureText(test).width > 780 && line) {
      ctx.fillText(line.trim(), 72, y); line = `${word} `; y += 92;
    } else line = test;
  });
  ctx.fillText(line.trim(), 72, y);
  ctx.font = '600 30px Arial, sans-serif';
  ctx.fillStyle = accent;
  ctx.fillText(settings.subtitle || 'İzlemeye değer içerik', 76, Math.min(y + 112, 610));
};
```


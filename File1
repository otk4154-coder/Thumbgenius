## 3. Önizleme Canvas — `src/components/thumbnail/ThumbnailCanvas.jsx`

```jsx
import React, { useEffect, useRef, useState } from 'react';
import { drawThumbnail } from '@/lib/thumbnailCanvas';

export default function ThumbnailCanvas({ settings, imageUrl, canvasRef }) {
  const localRef = useRef(null);
  const [image, setImage] = useState(null);

  useEffect(() => {
    if (!imageUrl) return setImage(null);
    const next = new Image();
    next.crossOrigin = 'anonymous';
    next.onload = () => setImage(next);
    next.src = imageUrl;
  }, [imageUrl]);

  useEffect(() => {
    const canvas = localRef.current;
    if (canvas) drawThumbnail(canvas, settings, image);
  }, [settings, image]);

  return (
    <div className="overflow-hidden rounded-2xl border border-border bg-card shadow-2xl shadow-primary/10">
      <canvas ref={(node) => { localRef.current = node; canvasRef.current = node; }} width="1280" height="720" className="block aspect-video w-full" aria-label="YouTube thumbnail önizlemesi" />
    </div>
  );
}
```

